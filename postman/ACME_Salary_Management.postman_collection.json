              "raw": "{\n  \"employeeCode\": \"EMP001\",\n  \"fullName\": \"Ada Lovelace\",\n  \"email\": \"ada@acme.com\",\n  \"jobTitle\": \"Engineer\",\n  \"departmentId\": {{departmentId}},\n  \"country\": \"India\",\n  \"grossSalary\": 50000,\n  \"currencyCode\": \"INR\",\n  \"hireDate\": \"2024-01-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees",
